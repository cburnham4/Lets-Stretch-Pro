<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Photo picking uses the system document picker (ACTION_GET_CONTENT); no storage permission needed. -->

    <application
        android:allowBackup="true"
        android:icon="@drawable/stretch_icon_114"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/MyMaterialTheme"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="36">

        <activity
            android:name=".activities.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".activities.StretchActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:exported="false" />

        <activity
            android:name=".activities.CreateRoutineActivity"
            android:exported="false" />

        <activity
            android:name=".activities.EditRoutineActivity"
            android:exported="false" />

    </application>

</manifest>
